# =============================================================================
# AdversarialIQ - S&P 500 AI Trading Terminal & Adversarial Syndicate
# Master Environment Configuration
# =============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8080
ENV=development

# -----------------------------------------------------------------------------
# 1. Alpaca Paper Trading API (https://docs.alpaca.markets/us/docs/getting-started)
# Paper Trading Base URL: https://paper-api.alpaca.markets
# -----------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# 2. AI Model Provider Credentials (On-Demand Switching & Failover)
# -----------------------------------------------------------------------------

# Groq Cloud API (Free high-speed inference: https://console.groq.com)
GROQ_API_KEY=

# Google AI Studio / Gemini API (https://aistudio.google.com)
# Models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_API_KEY=

# Mistral AI (https://console.mistral.ai)
# Models: mistral-small-latest, mistral-large-latest, codestral-latest
MISTRAL_API_KEY=

# NVIDIA NIM API (https://build.nvidia.com / https://integrate.api.nvidia.com)
# Models: z-ai/glm-5.3-flash, meta/llama-3.3-70b-instruct, mistralai/mistral-large-2-instruct
NVIDIA_API_KEY=

# Ollama Local Offline Daemon (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# 3. Market, News & Macroeconomic Data Layer Credentials
# -----------------------------------------------------------------------------

# SEC EDGAR Identity (Required by SEC Fair Access Policy: User-Agent header)
SEC_EDGAR_IDENTITY=AdversarialIQ diwasunnyhack519@gmail.com

# Finnhub Stock API (Free 60 calls/min: https://finnhub.io)
# Note: Terminal has an automatic zero-key RSS fallback if left empty.
FINNHUB_API_KEY=

# Federal Reserve Economic Data (FRED) API (Free: https://fred.stlouisfed.org)
# Note: Terminal has an automatic zero-key Treasury yield curve fallback if left empty.
FRED_API_KEY=
