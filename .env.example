# ==============================================================================
# S&P 500 AI Trader Terminal - Environment Configuration Example
# Copy this file to .env and configure your variables:
#   cp .env.example .env
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8080
ENV=production

# AI Model Provider Configuration
# 1. Groq Cloud (Free high-speed inference: https://console.groq.com)
GROQ_API_KEY=

# 2. Local Ollama Base URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# 3. CLI Terminal Server URL
TERMINAL_SERVER_URL=http://localhost:8080
