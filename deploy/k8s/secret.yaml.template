apiVersion: v1
kind: Secret
metadata:
  name: adversarialiq-secrets
  namespace: adversarialiq
type: Opaque
stringData:
  # Replace with actual base64 or plaintext values during deploy
  ALPACA_API_KEY: "your_alpaca_api_key_here"
  ALPACA_SECRET_KEY: "your_alpaca_secret_key_here"
  GROQ_API_KEY: "your_groq_api_key_here"
  GEMINI_API_KEY: "your_gemini_api_key_here"
  MISTRAL_API_KEY: "your_mistral_api_key_here"
  NVIDIA_API_KEY: "your_nvidia_api_key_here"
  LANGFUSE_PUBLIC_KEY: "pk-lf-your_langfuse_public_key"
  LANGFUSE_SECRET_KEY: "sk-lf-your_langfuse_secret_key"
  JWT_SECRET_KEY: "replace-with-a-random-32-char-secret-string"
  ADMIN_PASSWORD: "replace_with_strong_admin_password"
  FINNHUB_API_KEY: ""
  FRED_API_KEY: ""
